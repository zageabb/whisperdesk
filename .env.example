# WhisperDesk
SECRET_KEY=replace-with-a-long-random-value
HOST=0.0.0.0
PORT=5070

# Persistent runtime data (uploads, transcripts, SQLite)
WHISPERDESK_DATA_DIR=/home/YOUR_USER/.local/share/whisperdesk

# Faster-Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=true

# Upload limit
MAX_UPLOAD_MB=4096
LOG_LEVEL=INFO
