[Unit]
Description=WhisperDesk local transcription service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/whisperdesk
EnvironmentFile=-%h/whisperdesk/.env
ExecStart=/usr/bin/env bash %h/whisperdesk/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
